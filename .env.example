# =============================================================
# Portal Berita UKM Pilar Bangsa — Environment Variables
# Salin file ini menjadi .env.local dan isi dengan nilai asli
# JANGAN commit .env.local ke repository!
# =============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...    # Hanya untuk server-side, JANGAN expose ke browser!

# --- Resend (Email Transaksional) ---
# Daftar gratis di https://resend.com (3.000 email/bulan)
RESEND_API_KEY=re_xxxx
# Gunakan onboarding@resend.dev untuk testing, atau noreply@domain-anda.com jika sudah verifikasi domain
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Email Redaksi & Notifikasi Admin ---
ADMIN_EMAIL=ukmpilarbangsa@gmail.com

# --- URL Publik ---
# Di production: ganti dengan domain Vercel atau domain kustom Anda
NEXT_PUBLIC_SITE_URL=http://localhost:3000
